{
  "name": "A begin-review after start makes record-incident reject the incident with only an alert, and the record still finalizes",
  "harness": "claude",
  "config": "true",
  "inventory": "active",
  "external": [
    {
      "at": "after-start",
      "operation": "begin-review"
    }
  ],
  "packets": [
    {
      "bucket": "node-backend-cli",
      "paths": ["src/server/handler.mjs"],
      "incident": "safety",
      "incidentResult": "rejected"
    }
  ],
  "completion": "failed",
  "expected": {
    "configState": "enabled",
    "generationState": "active",
    "persistedGenerationState": "active",
    "activation": null,
    "operations": [
      "inventory",
      "start",
      "start-packet",
      "record-incident",
      "finish-packet",
      "finalize"
    ],
    "packets": [
      {
        "eligibility": "eligible",
        "selectedProfile": "fast",
        "recorded": true,
        "wire": {
          "selectedProfile": "fast",
          "wouldBeFastEligible": true,
          "gate": {
            "eligibility": "eligible",
            "firstReason": null
          }
        },
        "attempts": ["fast"],
        "fallback": "none",
        "fastAttemptConsumed": true,
        "attempt": "started"
      }
    ],
    "incidents": ["safety"],
    "finalize": {
      "completionStatus": "failed",
      "qualityCorrectionRounds": 0,
      "packets": [
        {
          "fallback": "none",
          "escalated": false
        }
      ]
    },
    "events": [
      {
        "kind": "alert",
        "operation": "record-incident",
        "report": "value-free-alert"
      }
    ]
  }
}
