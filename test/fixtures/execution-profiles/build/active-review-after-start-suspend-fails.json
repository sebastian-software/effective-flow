{
  "name": "A begin-review after start makes an incident's suspend fail with only an alert, and the record still finalizes",
  "harness": "claude",
  "config": "true",
  "inventory": "active",
  "external": [
    {
      "at": "after-start",
      "operation": "begin-review"
    }
  ],
  "packets": [
    {
      "bucket": "node-backend-cli",
      "paths": ["src/server/handler.mjs"],
      "incident": "safety",
      "suspendResult": "failed"
    }
  ],
  "completion": "failed",
  "expected": {
    "configState": "enabled",
    "generationState": "active",
    "persistedGenerationState": "active",
    "operations": ["inventory", "start", "start-packet", "suspend", "finish-packet", "finalize"],
    "packets": [
      {
        "eligibility": "eligible",
        "selectedProfile": "fast",
        "recorded": true,
        "wire": {
          "selectedProfile": "fast",
          "wouldBeFastEligible": true,
          "gate": {
            "eligibility": "eligible",
            "firstReason": null
          }
        },
        "attempts": ["fast"],
        "fallback": "none",
        "fastAttemptConsumed": true
      }
    ],
    "suspend": ["critical-safety-incident"],
    "finalize": {
      "completionStatus": "failed",
      "qualityCorrectionRounds": 0,
      "packets": [
        {
          "fallback": "none",
          "escalated": false
        }
      ]
    },
    "events": [
      {
        "kind": "alert",
        "operation": "suspend",
        "report": "value-free-alert"
      }
    ]
  }
}
