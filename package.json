{
  "name": "effective-flow",
  "private": true,
  "description": "Effective Flow — single-source, lazy-loading /effective-flow <tool> skill set for Codex and Claude Code",
  "scripts": {
    "build": "node build.mjs",
    "format": "oxfmt",
    "agent:check": "oxfmt --check",
    "audit:skill-ownership": "node scripts/audit-skill-ownership.mjs",
    "test": "node --test",
    "test:distribution": "node scripts/distribution-smoke.mjs offline",
    "test:managers": "node scripts/distribution-smoke.mjs managers"
  },
  "devDependencies": {
    "oxfmt": "^0.59.0"
  },
  "packageManager": "pnpm@11.11.0"
}
